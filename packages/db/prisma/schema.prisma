generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  fullName    String
  role        String
  managerId   String?
  baseSalary  Float?
  department  String
  manager     User?    @relation("UserManager", fields: [managerId], references: [id])
  directReports User[] @relation("UserManager")
  managedDepartments Department[] @relation("DepartmentManager")
  employeeProfile EmployeeProfile?
  requestedHiringRequests HiringRequest[] @relation("HiringRequestRequester")
  managedHiringRequests HiringRequest[] @relation("HiringRequestManager")
  interviews Interview[] @relation("InterviewInterviewer")
  buddyOnboardingPlans OnboardingPlan[] @relation("OnboardingBuddy")
  accounts    Account[]
  refreshTokens RefreshToken[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  parentId      String?
  parent        Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children      Department[]  @relation("DepartmentHierarchy")
  managerUserId String?
  managerUser   User?         @relation("DepartmentManager", fields: [managerUserId], references: [id])
  employeeProfiles EmployeeProfile[]
  contracts     Contract[]
  hiringRequests HiringRequest[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model EmployeeProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String      @unique
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  jobTitle        String
  employmentStatus String     @default("ACTIVE")
  hireDate        DateTime
  dateOfBirth     DateTime?
  phoneNumber     String?
  address         String?
  emergencyContactName String?
  emergencyContactPhone String?
  contracts       Contract[]
  onboardingPlans OnboardingPlan[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([departmentId])
}

model Contract {
  id                String      @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department  @relation(fields: [departmentId], references: [id])
  contractType      String
  startDate         DateTime
  endDate           DateTime?
  baseSalary        Float
  salaryCurrency    String      @default("VND")
  payrollCycle      String      @default("MONTHLY")
  signedAt          DateTime?
  status            String      @default("ACTIVE")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([employeeProfileId])
  @@index([departmentId])
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("credentials")
  password    String?  // Hashed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model HiringRequest {
  id              String        @id @default(cuid())
  requestCode     String        @unique
  title           String
  description     String?
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  requesterId     String
  requester       User          @relation("HiringRequestRequester", fields: [requesterId], references: [id])
  hiringManagerId String?
  hiringManager   User?         @relation("HiringRequestManager", fields: [hiringManagerId], references: [id])
  employmentType  String
  headcount       Int           @default(1)
  priority        String        @default("NORMAL")
  status          String        @default("PENDING_APPROVAL")
  approvalNote    String?
  approvedAt      DateTime?
  requestedAt     DateTime      @default(now())
  slaDeadlineAt   DateTime
  slaAlertedAt    DateTime?
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([departmentId])
  @@index([requesterId])
  @@index([status])
}

model Candidate {
  id            String        @id @default(cuid())
  fullName      String
  email         String        @unique
  phoneNumber   String?
  source        String?
  currentCompany String?
  notes         String?
  status        String        @default("NEW")
  appliedAt     DateTime      @default(now())
  applications  Application[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Application {
  id               String        @id @default(cuid())
  hiringRequestId  String
  hiringRequest    HiringRequest @relation(fields: [hiringRequestId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status           String        @default("APPLIED")
  score            Float?
  notes            String?
  interviews       Interview[]
  onboardingPlan   OnboardingPlan?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([hiringRequestId, candidateId])
  @@index([status])
}

model Interview {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId  String?
  interviewer    User?       @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  roundLabel     String
  scheduledAt    DateTime
  result         String      @default("PENDING")
  feedback       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId])
  @@index([interviewerId])
}

model OnboardingPlan {
  id                 String          @id @default(cuid())
  employeeProfileId  String
  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  applicationId      String?         @unique
  application        Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  buddyUserId        String?
  buddyUser          User?           @relation("OnboardingBuddy", fields: [buddyUserId], references: [id])
  template           String          @default("30-60-90")
  status             String          @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  tasks              OnboardingTask[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([employeeProfileId])
  @@index([buddyUserId])
}

model OnboardingTask {
  id               String         @id @default(cuid())
  onboardingPlanId String
  onboardingPlan   OnboardingPlan @relation(fields: [onboardingPlanId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  phaseDay         Int
  dueDate          DateTime
  status           String         @default("TODO")
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([onboardingPlanId])
  @@index([phaseDay])
}

