generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  fullName    String
  role        String
  managerId   String?
  baseSalary  Float?
  department  String
  manager     User?    @relation("UserManager", fields: [managerId], references: [id])
  directReports User[] @relation("UserManager")
  managedDepartments Department[] @relation("DepartmentManager")
  employeeProfile EmployeeProfile?
  accounts    Account[]
  refreshTokens RefreshToken[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  parentId      String?
  parent        Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children      Department[]  @relation("DepartmentHierarchy")
  managerUserId String?
  managerUser   User?         @relation("DepartmentManager", fields: [managerUserId], references: [id])
  employeeProfiles EmployeeProfile[]
  contracts     Contract[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model EmployeeProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String      @unique
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  jobTitle        String
  employmentStatus String     @default("ACTIVE")
  hireDate        DateTime
  dateOfBirth     DateTime?
  phoneNumber     String?
  address         String?
  emergencyContactName String?
  emergencyContactPhone String?
  contracts       Contract[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([departmentId])
}

model Contract {
  id                String      @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department  @relation(fields: [departmentId], references: [id])
  contractType      String
  startDate         DateTime
  endDate           DateTime?
  baseSalary        Float
  salaryCurrency    String      @default("VND")
  payrollCycle      String      @default("MONTHLY")
  signedAt          DateTime?
  status            String      @default("ACTIVE")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([employeeProfileId])
  @@index([departmentId])
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("credentials")
  password    String?  // Hashed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

