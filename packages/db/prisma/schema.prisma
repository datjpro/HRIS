generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  fullName    String
  role        String
  managerId   String?
  baseSalary  Float?
  department  String
  manager     User?    @relation("UserManager", fields: [managerId], references: [id])
  directReports User[] @relation("UserManager")
  managedDepartments Department[] @relation("DepartmentManager")
  employeeProfile EmployeeProfile?
  requestedHiringRequests HiringRequest[] @relation("HiringRequestRequester")
  managedHiringRequests HiringRequest[] @relation("HiringRequestManager")
  interviews Interview[] @relation("InterviewInterviewer")
  buddyOnboardingPlans OnboardingPlan[] @relation("OnboardingBuddy")
  generatedPayslips Payslip[] @relation("PayslipGenerator")
  accounts    Account[]
  refreshTokens RefreshToken[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  parentId      String?
  parent        Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children      Department[]  @relation("DepartmentHierarchy")
  managerUserId String?
  managerUser   User?         @relation("DepartmentManager", fields: [managerUserId], references: [id])
  employeeProfiles EmployeeProfile[]
  contracts     Contract[]
  hiringRequests HiringRequest[]
  salaryBands   SalaryBand[]
  kpiMetrics    KpiMetric[]
  trainingCourses TrainingCourse[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model EmployeeProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String      @unique
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  jobTitle        String
  employmentStatus String     @default("ACTIVE")
  hireDate        DateTime
  dateOfBirth     DateTime?
  phoneNumber     String?
  address         String?
  emergencyContactName String?
  emergencyContactPhone String?
  terminationDate DateTime?
  contracts       Contract[]
  onboardingPlans OnboardingPlan[]
  kpiResults      KpiResult[]
  payslips        Payslip[]
  trainingEnrollments TrainingEnrollment[]
  idpPlans        IdpPlan[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([departmentId])
}

model Contract {
  id                String      @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department  @relation(fields: [departmentId], references: [id])
  contractType      String
  startDate         DateTime
  endDate           DateTime?
  baseSalary        Float
  salaryCurrency    String      @default("VND")
  payrollCycle      String      @default("MONTHLY")
  signedAt          DateTime?
  status            String      @default("ACTIVE")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([employeeProfileId])
  @@index([departmentId])
}

model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("credentials")
  password    String?  // Hashed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model HiringRequest {
  id              String        @id @default(cuid())
  requestCode     String        @unique
  title           String
  description     String?
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  requesterId     String
  requester       User          @relation("HiringRequestRequester", fields: [requesterId], references: [id])
  hiringManagerId String?
  hiringManager   User?         @relation("HiringRequestManager", fields: [hiringManagerId], references: [id])
  employmentType  String
  headcount       Int           @default(1)
  priority        String        @default("NORMAL")
  status          String        @default("PENDING_APPROVAL")
  approvalNote    String?
  approvedAt      DateTime?
  requestedAt     DateTime      @default(now())
  slaDeadlineAt   DateTime
  slaAlertedAt    DateTime?
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([departmentId])
  @@index([requesterId])
  @@index([status])
}

model Candidate {
  id            String        @id @default(cuid())
  fullName      String
  email         String        @unique
  phoneNumber   String?
  source        String?
  currentCompany String?
  notes         String?
  status        String        @default("NEW")
  appliedAt     DateTime      @default(now())
  applications  Application[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Application {
  id               String        @id @default(cuid())
  hiringRequestId  String
  hiringRequest    HiringRequest @relation(fields: [hiringRequestId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status           String        @default("APPLIED")
  score            Float?
  notes            String?
  interviews       Interview[]
  onboardingPlan   OnboardingPlan?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([hiringRequestId, candidateId])
  @@index([status])
}

model Interview {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId  String?
  interviewer    User?       @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  roundLabel     String
  scheduledAt    DateTime
  result         String      @default("PENDING")
  feedback       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId])
  @@index([interviewerId])
}

model OnboardingPlan {
  id                 String          @id @default(cuid())
  employeeProfileId  String
  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  applicationId      String?         @unique
  application        Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  buddyUserId        String?
  buddyUser          User?           @relation("OnboardingBuddy", fields: [buddyUserId], references: [id])
  template           String          @default("30-60-90")
  status             String          @default("PENDING")
  startedAt          DateTime?
  completedAt        DateTime?
  tasks              OnboardingTask[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([employeeProfileId])
  @@index([buddyUserId])
}

model OnboardingTask {
  id               String         @id @default(cuid())
  onboardingPlanId String
  onboardingPlan   OnboardingPlan @relation(fields: [onboardingPlanId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  phaseDay         Int
  dueDate          DateTime
  status           String         @default("TODO")
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([onboardingPlanId])
  @@index([phaseDay])
}

model SalaryBand {
  id               String     @id @default(cuid())
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleLevel        String
  minBaseSalary    Float
  maxBaseSalary    Float
  allowanceDefault Float      @default(0)
  currency         String     @default("VND")
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([departmentId, roleLevel])
  @@index([departmentId])
}

model KpiMetric {
  id            String     @id @default(cuid())
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code          String     @unique
  name          String
  description   String?
  weight        Float
  targetValue   Float?
  unit          String?
  isActive      Boolean    @default(true)
  results       KpiResult[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([departmentId])
}

model KpiResult {
  id                 String          @id @default(cuid())
  employeeProfileId  String
  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  metricId           String
  metric             KpiMetric       @relation(fields: [metricId], references: [id], onDelete: Cascade)
  period             String
  achievedValue      Float?
  score              Float
  bonusAmount        Float           @default(0)
  note               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([employeeProfileId, metricId, period])
  @@index([period])
}

model Payslip {
  id                 String          @id @default(cuid())
  employeeProfileId  String
  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  period             String
  grossBaseSalary    Float
  kpiBonus           Float           @default(0)
  allowance          Float           @default(0)
  deduction          Float           @default(0)
  netSalary          Float
  currency           String          @default("VND")
  generatedByUserId  String?
  generatedByUser    User?           @relation("PayslipGenerator", fields: [generatedByUserId], references: [id])
  generatedAt        DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([employeeProfileId, period])
  @@index([period])
}

model TrainingCourse {
  id                 String               @id @default(cuid())
  departmentId       String?
  department         Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  code               String               @unique
  title              String
  description        String?
  provider           String?
  commitmentMonths   Int                  @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  status             String               @default("PLANNED")
  enrollments        TrainingEnrollment[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model TrainingEnrollment {
  id                  String           @id @default(cuid())
  trainingCourseId    String
  trainingCourse      TrainingCourse   @relation(fields: [trainingCourseId], references: [id], onDelete: Cascade)
  employeeProfileId   String
  employeeProfile     EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  enrolledAt          DateTime         @default(now())
  completedAt         DateTime?
  commitmentEndDate   DateTime?
  status              String           @default("ENROLLED")
  violationFlaggedAt  DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([trainingCourseId, employeeProfileId])
  @@index([commitmentEndDate])
}

model IdpPlan {
  id                 String           @id @default(cuid())
  employeeProfileId  String
  employeeProfile    EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  title              String
  objective          String
  targetDate         DateTime?
  status             String           @default("ACTIVE")
  progressNote       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([employeeProfileId])
}

model EnpsSurvey {
  id             String    @id @default(cuid())
  period         String
  score          Int
  comment        String?
  departmentCode String?
  submittedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([period])
}

